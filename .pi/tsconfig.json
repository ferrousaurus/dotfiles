{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "#extensions/*": [
        "./agent/extensions/*"
      ],
      "#lib/*": [
        "./lib/*"
      ],
    },
    "rootDir": ".",
    "strict": true,
    "noEmit": true,
    "types": [
      "node",
      "./env.d.ts"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "lib/**/*.ts",
    "agent/extensions/**/*.ts",
  ]
}
