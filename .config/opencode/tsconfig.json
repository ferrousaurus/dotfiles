{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "#lib/*": [
        "./lib/*"
      ],
    },
    "rootDir": ".",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
  },
  "include": [
    "lib/**/*.ts",
    "plugins/**/*.ts",
    "tools/**/*.ts"
  ]
}
