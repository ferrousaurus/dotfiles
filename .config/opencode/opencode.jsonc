{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "github-readonly_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github-mutate_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env.local",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.env.local",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env.local.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.env.local.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*/.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": ".env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*/.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": ".env.schema",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*/.env.schema",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".envrc.private",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.envrc.private",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".secrets",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.secrets",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".secrets.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.secrets.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pfx",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "credentials.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/credentials.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "service-account*.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/service-account*.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "terraform.tfstate",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/terraform.tfstate",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "terraform.tfstate.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/terraform.tfstate.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".terraform/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.terraform/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.aws/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.kube/config",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.docker/config.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.npmrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.pypirc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.netrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "review",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/**",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/oxlint/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.dotfiles/.agents/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.dotfiles/.config/**",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/**",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Source/**",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/source/**",
      "effect": "ask"
    }
  ],
  "agents": {
