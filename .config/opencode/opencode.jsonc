          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "nub run check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nub run fmt:check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nub run format:check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nub run lint",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nub run lint:check",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nub run test",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "review",
          "effect": "allow"
        }
      ]
    }
  },
  "default_agent": "plan",
  "formatter": {},
  "lsp": {},
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "nubx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "github-readonly": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions",
          "X-MCP-Readonly": "true"
        },
        "disabled": true
      },
      "github-mutate": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}",
          "X-MCP-Toolsets": "context",
          "X-MCP-Tools": "add_issue_comment,issue_write,update_issue_comment,create_pull_request,update_pull_request,add_comment_to_pending_review,add_reply_to_pull_request_comment,pull_request_review_write"
        },
        "disabled": true
      }
    }
  },
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "providers": {
    "github-copilot": {},
    "openai": {},
    "copilot": {},
    "opencode-go": {}
  },
  "share": "disabled",
  "skills": [
    "~/source/.agents/skills"
  ]
}
