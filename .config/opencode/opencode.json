{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/**": "deny",
      "~/.agents/**": "allow",
      "~/.config/**": "ask",
      "~/.config/opencode/**": "allow",
      "~/.config/oxlint/**": "allow",
      "~/.dotfiles/.agents/**": "allow",
      "~/.dotfiles/.config/**": "ask",
      "~/.local/share/**": "ask",
      "~/.local/share/opencode/**": "allow",
      "~/Source/**": "ask",
      "~/source/**": "ask"
    },
    "read": {
      "*": "allow",
      ".env.local": "deny",
      "*/.env.local": "deny",
      ".env.local.*": "deny",
      "*/.env.local.*": "deny",
      ".env": "ask",
      "*/.env": "ask",
      ".env.*": "ask",
      "*/.env.*": "ask",
      ".env.schema": "allow",
      "*/.env.schema": "allow",
      ".envrc.private": "deny",
      "*/.envrc.private": "deny",
      ".secrets": "deny",
      "*/.secrets": "deny",
      ".secrets.*": "deny",
      "*/.secrets.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "service-account*.json": "deny",
      "*/service-account*.json": "deny",
      "terraform.tfstate": "deny",
      "*/terraform.tfstate": "deny",
      "terraform.tfstate.*": "deny",
      "*/terraform.tfstate.*": "deny",
      ".terraform/**": "deny",
      "*/.terraform/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny"
    },
    "skill": {
      "review": "deny"
    }
  },
  "agent": {
    "plan": {
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "bash": {
          "*": "deny",
          "nub task check": "allow",
          "nub task format:check": "allow",
          "nub task fmt:check": "allow",
          "nub task lint": "allow",
          "nub task lint:check": "allow",
          "nub task test": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": "deny",
        "mcp_azure_*": "allow",
        "mcp_azure_*_add": "deny",
        "mcp_azure_*_append": "deny",
        "mcp_azure_*_apply": "deny",
        "mcp_azure_*_cancel": "deny",
        "mcp_azure_*_changedetection": "deny",
        "mcp_azure_*_create": "deny",
        "mcp_azure_*_createorupdate": "deny",
        "mcp_azure_*_delete": "deny",
        "mcp_azure_*_deploy": "deny",
        "mcp_azure_*_drain": "deny",
        "mcp_azure_*_execute": "deny",
        "mcp_azure_*_grant": "deny",
        "mcp_azure_*_import": "deny",
        "mcp_azure_*_lock": "deny",
        "mcp_azure_*_orchestrator-next": "deny",
        "mcp_azure_*_orchestrator-start": "deny",
        "mcp_azure_*_publish": "deny",
        "mcp_azure_*_purge": "deny",
        "mcp_azure_*_recover": "deny",
        "mcp_azure_*_reimage": "deny",
        "mcp_azure_*_remove": "deny",
        "mcp_azure_*_rename": "deny",
        "mcp_azure_*_request": "deny",
        "mcp_azure_*_restart": "deny",
        "mcp_azure_*_restore": "deny",
        "mcp_azure_*_revoke": "deny",
        "mcp_azure_*_rotate": "deny",
        "mcp_azure_*_run": "deny",
        "mcp_azure_*_scale": "deny",
        "mcp_azure_*_send": "deny",
        "mcp_azure_*_send-*": "deny",
        "mcp_azure_*_set": "deny",
        "mcp_azure_*_snapshot": "deny",
        "mcp_azure_*_start": "deny",
        "mcp_azure_*_stop": "deny",
        "mcp_azure_*_swap": "deny",
        "mcp_azure_*_sync": "deny",
        "mcp_azure_*_synthesize": "deny",
        "mcp_azure_*_trigger": "deny",
        "mcp_azure_*_unlock": "deny",
        "mcp_azure_*_unregister": "deny",
        "mcp_azure_*_update": "deny",
        "mcp_azure_*_update-appsettings": "deny",
        "mcp_azure_*_upload": "deny",
        "mcp_chrome-devtools_*": "ask",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "documenter": "allow",
          "review-accessibility": "allow",
          "review-contracts": "allow",
          "review-migration": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-style": "allow",
          "review-performance": "allow",
          "review-verification": "allow"
        }
      }
    },
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "bash": {
          "*": "ask",
          "nub task build": "ask",
          "nub task check": "allow",
          "nub task fmt": "allow",
          "nub task fmt:check": "allow",
          "nub task format": "allow",
          "nub task format:check": "allow",
          "nub task lint": "allow",
          "nub task lint:check": "allow",
          "nub task lint:fix": "allow",
          "nub task test": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": "allow",
        "mcp_azure_*": "allow",
        "mcp_azure_*_add": "ask",
        "mcp_azure_*_append": "ask",
        "mcp_azure_*_apply": "ask",
        "mcp_azure_*_cancel": "ask",
        "mcp_azure_*_changedetection": "ask",
        "mcp_azure_*_create": "ask",
        "mcp_azure_*_createorupdate": "ask",
        "mcp_azure_*_delete": "ask",
        "mcp_azure_*_deploy": "ask",
        "mcp_azure_*_drain": "ask",
        "mcp_azure_*_execute": "ask",
        "mcp_azure_*_grant": "ask",
        "mcp_azure_*_import": "ask",
        "mcp_azure_*_lock": "ask",
        "mcp_azure_*_orchestrator-next": "ask",
        "mcp_azure_*_orchestrator-start": "ask",
        "mcp_azure_*_publish": "ask",
        "mcp_azure_*_purge": "ask",
        "mcp_azure_*_recover": "ask",
        "mcp_azure_*_reimage": "ask",
        "mcp_azure_*_remove": "ask",
        "mcp_azure_*_rename": "ask",
        "mcp_azure_*_request": "ask",
        "mcp_azure_*_restart": "ask",
        "mcp_azure_*_restore": "ask",
        "mcp_azure_*_revoke": "ask",
        "mcp_azure_*_rotate": "ask",
        "mcp_azure_*_run": "ask",
        "mcp_azure_*_scale": "ask",
        "mcp_azure_*_send": "ask",
        "mcp_azure_*_send-*": "ask",
        "mcp_azure_*_set": "ask",
        "mcp_azure_*_snapshot": "ask",
        "mcp_azure_*_start": "ask",
        "mcp_azure_*_stop": "ask",
        "mcp_azure_*_swap": "ask",
        "mcp_azure_*_sync": "ask",
        "mcp_azure_*_synthesize": "ask",
        "mcp_azure_*_trigger": "ask",
        "mcp_azure_*_unlock": "ask",
        "mcp_azure_*_unregister": "ask",
        "mcp_azure_*_update": "ask",
        "mcp_azure_*_update-appsettings": "ask",
        "mcp_azure_*_upload": "ask",
        "mcp_chrome-devtools_*": "ask",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow",
          "implementer": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "documenter": "allow",
          "review-accessibility": "allow",
          "review-contracts": "allow",
          "review-migration": "allow",
          "review-performance": "allow",
          "review-spec": "allow",
          "review-style": "allow",
          "review-security": "allow",
          "review-verification": "allow"
        }
      }
    },
    "explore": {
      "description": "Performs bounded local repository discovery and dependency tracing.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explorer.md}"
    },
    "general": {},
    "title": {},
    "summary": {},
    "compaction": {},
    "researcher": {
      "description": "Performs bounded external and version-specific research using authoritative sources.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "webfetch": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/researcher.md}"
    },
    "implementer": {
      "description": "Performs bounded implementation work within explicit caller-owned files or subsystems.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/implementer.md}"
    },
    "debugger": {
      "description": "Investigates failures and returns evidence-based root cause analyses and resolution guidance.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "npm test": "allow",
          "npm run format:check": "allow",
          "npm run lint": "allow",
          "npm run lint:check": "allow",
          "npm run check": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/debugger.md}"
    },
    "documenter": {
      "description": "Drafts ready-to-apply technical documentation and returns it to the calling agent.",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/documenter.md}"
    },
    "reviewer": {
      "description": "Independently reviews changes for correctness, regressions, convention compliance, and readiness.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "nub task check": "allow",
          "nub task fmt:check": "allow",
          "nub task format:check": "allow",
          "nub task lint": "allow",
          "nub task lint:check": "allow",
          "nub task test": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny",
        "skill": {
          "review": "allow"
        }
      },
      "prompt": "{file:./prompts/reviewer.md}"
    }
  },
  "default_agent": "plan",
  "formatter": {},
  "lsp": {},
  "mcp": {
    "azure": {
      "type": "local",
      "command": [
        "dnx",
        "Azure.Mcp",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes",
        "--",
        "azmcp",
        "server",
        "start"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "nubx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    }
  },
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "share": "disabled",
  "provider": {
    "openai": {},
    "copilot": {},
    "opencode-go": {}
  }
}
