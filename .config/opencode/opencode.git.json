{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env.local": "deny",
      "*/.env.local": "deny",
      ".env.local.*": "deny",
      "*/.env.local.*": "deny",
      ".env": "ask",
      "*/.env": "ask",
      ".env.*": "ask",
      "*/.env.*": "ask",
      ".env.schema": "allow",
      "*/.env.schema": "allow",
      ".envrc.private": "deny",
      "*/.envrc.private": "deny",
      ".secrets": "deny",
      "*/.secrets": "deny",
      ".secrets.*": "deny",
      "*/.secrets.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "service-account*.json": "deny",
      "*/service-account*.json": "deny",
      "terraform.tfstate": "deny",
      "*/terraform.tfstate": "deny",
      "terraform.tfstate.*": "deny",
      "*/terraform.tfstate.*": "deny",
      ".terraform/**": "deny",
      "*/.terraform/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "Implements and verifies changes, delegating bounded work aggressively.",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "implementer": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "prompt": "{file:./prompts/build.md}"
    },
    "plan": {
      "description": "Investigates requests and produces implementation-ready plans without making changes.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "deny",
          "deno task check": "allow",
          "deno task lint": "allow",
          "deno task lint:check": "allow",
          "deno task format:check": "allow",
          "npm task check": "allow",
          "npm task lint": "allow",
          "npm task lint:check": "allow",
          "npm task format:check": "allow",
          "nub task check": "allow",
          "nub task lint": "allow",
          "nub task format:check": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/plans/*.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "prompt": "{file:./prompts/plan.md}"
    },
    "specify": {
      "description": "Investigates requests and produces implementation-ready plans without making changes.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "deny",
          "deno task check": "allow",
          "deno task lint": "allow",
          "deno task lint:check": "allow",
          "deno task format:check": "allow",
          "npm task check": "allow",
          "npm task lint": "allow",
          "npm task lint:check": "allow",
          "npm task format:check": "allow",
          "nub task check": "allow",
          "nub task lint": "allow",
          "nub task format:check": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/specs/*.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "prompt": "{file:./prompts/plan.md}"
    },
    "explore": {
      "description": "Performs bounded local repository discovery and dependency tracing.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explorer.md}"
    },
    "scout-reuse": {
      "description": "Finds reusable local helpers, utilities, hooks, components, and patterns for proposed implementation work.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/scout-reuse.md}"
    },
    "general": {},
    "title": {},
    "summary": {},
    "compaction": {},
    "librarian": {
      "description": "Performs bounded external and version-specific research using authoritative sources.",
      "hidden": true,
      "mode": "subagent",
      "permission": { "bash": "deny", "edit": "deny", "webfetch": "allow", "task": "deny" },
      "prompt": "{file:./prompts/librarian.md}"
    },
    "implementer": {
      "description": "Performs bounded implementation work within explicit caller-owned files or subsystems.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/implementer.md}"
    },
    "debugger": {
      "description": "Investigates failures and returns evidence-based root cause analyses and resolution guidance.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "npm test": "allow",
          "npm run format:check": "allow",
          "npm run lint": "allow",
          "npm run lint:check": "allow",
          "npm run check": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/debugger.md}"
    },
    "documenter": {
      "description": "Drafts ready-to-apply technical documentation and returns it to the calling agent.",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/documenter.md}"
    },
    "reviewer": {
      "description": "Independently reviews changes for correctness, regressions, convention compliance, and readiness.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/reviewer.md}"
    },
    "review-style": {
      "description": "Reviews changed code against applicable repository coding conventions.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-style.md}"
    },
    "review-verification": {
      "description": "Executes and reports deterministic repository checks without diagnosing or changing them.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "git status --short --untracked-files=all": "allow",
          "git diff --check": "allow",
          "jq empty .config/opencode/opencode.git.json": "allow",
          "jq empty .config/opencode/opencode2.git.json": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-verification.md}"
    },
    "review-spec": {
      "description": "Reviews requirements and acceptance-criteria traceability.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-spec.md}"
    },
    "review-security": {
      "description": "Reviews threats, security controls, and exploitable weaknesses.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-security.md}"
    },
    "review-contracts": {
      "description": "Reviews public interface semantics and compatibility.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-contracts.md}"
    },
    "review-accessibility": {
      "description": "Reviews accessible user flows and interaction semantics.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-accessibility.md}"
    },
    "review-migration": {
      "description": "Reviews state transitions, rollout, recovery, and compatibility windows.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-migration.md}"
    },
    "review-performance": {
      "description": "Reviews measured regressions and credible scalability risks.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "prompt": "{file:./prompts/review-performance.md}"
    }
  },
  "default_agent": "plan",
  "formatter": {},
  "lsp": {},
  "plugin": ["@slkiser/opencode-quota@latest"],
  "share": "disabled"
}
