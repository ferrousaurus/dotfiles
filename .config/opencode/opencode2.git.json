{
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".env.local", "effect": "deny" },
    { "action": "read", "resource": "*/.env.local", "effect": "deny" },
    { "action": "read", "resource": ".env.local.*", "effect": "deny" },
    { "action": "read", "resource": "*/.env.local.*", "effect": "deny" },
    { "action": "read", "resource": ".env", "effect": "ask" },
    { "action": "read", "resource": "*/.env", "effect": "ask" },
    { "action": "read", "resource": ".env.*", "effect": "ask" },
    { "action": "read", "resource": "*/.env.*", "effect": "ask" },
    { "action": "read", "resource": ".env.schema", "effect": "allow" },
    { "action": "read", "resource": "*/.env.schema", "effect": "allow" },
    { "action": "read", "resource": ".envrc.private", "effect": "deny" },
    { "action": "read", "resource": "*/.envrc.private", "effect": "deny" },
    { "action": "read", "resource": ".secrets", "effect": "deny" },
    { "action": "read", "resource": "*/.secrets", "effect": "deny" },
    { "action": "read", "resource": ".secrets.*", "effect": "deny" },
    { "action": "read", "resource": "*/.secrets.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "*/service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "terraform.tfstate", "effect": "deny" },
    { "action": "read", "resource": "*/terraform.tfstate", "effect": "deny" },
    { "action": "read", "resource": "terraform.tfstate.*", "effect": "deny" },
    { "action": "read", "resource": "*/terraform.tfstate.*", "effect": "deny" },
    { "action": "read", "resource": ".terraform/**", "effect": "deny" },
    { "action": "read", "resource": "*/.terraform/**", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/config", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" }
  ],
  "agents": {
    "plan": { "color": "primary" },
    "build": { "color": "secondary" },
    "specify": {
      "color": "error",
      "description": "Investigates requests and produces implementation-ready plans without making changes.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "deny",
          "deno task check": "allow",
          "deno task lint": "allow",
          "deno task lint:check": "allow",
          "deno task format:check": "allow",
          "npm task check": "allow",
          "npm task lint": "allow",
          "npm task lint:check": "allow",
          "npm task format:check": "allow",
          "nub task check": "allow",
          "nub task lint": "allow",
          "nub task format:check": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/specs/*.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "system": "{file:./prompts/specify.md}"
    },
    "strategize": {
      "color": "warning",
      "description": "Investigates requests and produces implementation-ready plans without making changes.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "deny",
          "deno task check": "allow",
          "deno task lint": "allow",
          "deno task lint:check": "allow",
          "deno task format:check": "allow",
          "npm task check": "allow",
          "npm task lint": "allow",
          "npm task lint:check": "allow",
          "npm task format:check": "allow",
          "nub task check": "allow",
          "nub task lint": "allow",
          "nub task format:check": "allow",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/plans/*.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "system": "{file:./prompts/strategize.md}"
    },
    "execute": {
      "color": "success",
      "description": "Implements and verifies changes, delegating bounded work aggressively.",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout-reuse": "allow",
          "librarian": "allow",
          "implementer": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "review-style": "allow",
          "documenter": "allow",
          "review-verification": "allow",
          "review-spec": "allow",
          "review-security": "allow",
          "review-contracts": "allow",
          "review-accessibility": "allow",
          "review-migration": "allow",
          "review-performance": "allow"
        }
      },
      "system": "{file:./prompts/execute.md}"
    },
    "explore": {
      "description": "Performs bounded local repository discovery and dependency tracing.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/explorer.md}"
    },
    "scout-reuse": {
      "description": "Finds reusable local helpers, utilities, hooks, components, and patterns for proposed implementation work.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/scout-reuse.md}"
    },
    "general": {},
    "title": {},
    "summary": {},
    "compaction": {},
    "librarian": {
      "description": "Performs bounded external and version-specific research using authoritative sources.",
      "hidden": true,
      "mode": "subagent",
      "permission": { "bash": "deny", "edit": "deny", "webfetch": "allow", "task": "deny" },
      "system": "{file:./prompts/librarian.md}"
    },
    "implementer": {
      "description": "Performs bounded implementation work within explicit caller-owned files or subsystems.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/implementer.md}"
    },
    "debugger": {
      "description": "Investigates failures and returns evidence-based root cause analyses and resolution guidance.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "npm test": "allow",
          "npm run format:check": "allow",
          "npm run lint": "allow",
          "npm run lint:check": "allow",
          "npm run check": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/debugger.md}"
    },
    "documenter": {
      "description": "Drafts ready-to-apply technical documentation and returns it to the calling agent.",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/documenter.md}"
    },
    "reviewer": {
      "description": "Independently reviews changes for correctness, regressions, convention compliance, and readiness.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "git merge-base origin/develop HEAD": "allow",
          "git log --format=%H origin/develop..HEAD": "allow",
          "git diff --no-ext-diff --merge-base origin/develop HEAD": "allow",
          "git diff --no-ext-diff --cached": "allow",
          "git diff --no-ext-diff": "allow",
          "git status --short --untracked-files=all": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/reviewer.md}"
    },
    "review-style": {
      "description": "Reviews changed code against applicable repository coding conventions.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-style.md}"
    },
    "review-verification": {
      "description": "Executes and reports deterministic repository checks without diagnosing or changing them.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "git status --short --untracked-files=all": "allow",
          "git diff --check": "allow",
          "jq empty .config/opencode/opencode.git.json": "allow",
          "jq empty .config/opencode/opencode2.git.json": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-verification.md}"
    },
    "review-spec": {
      "description": "Reviews requirements and acceptance-criteria traceability.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-spec.md}"
    },
    "review-security": {
      "description": "Reviews threats, security controls, and exploitable weaknesses.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-security.md}"
    },
    "review-contracts": {
      "description": "Reviews public interface semantics and compatibility.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-contracts.md}"
    },
    "review-accessibility": {
      "description": "Reviews accessible user flows and interaction semantics.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-accessibility.md}"
    },
    "review-migration": {
      "description": "Reviews state transitions, rollout, recovery, and compatibility windows.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-migration.md}"
    },
    "review-performance": {
      "description": "Reviews measured regressions and credible scalability risks.",
      "disable": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/review-performance.md}"
    }
  },
  "default_agent": "plan",
  "formatter": {},
  "lsp": {},
  "mcp": { "servers": {} },
  "media": { "image": { "auto_resize": true } },
  "plugins": [],
  "share": "disabled"
}
