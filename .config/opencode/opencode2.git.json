{
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".env.local", "effect": "deny" },
    { "action": "read", "resource": "*/.env.local", "effect": "deny" },
    { "action": "read", "resource": ".env.local.*", "effect": "deny" },
    { "action": "read", "resource": "*/.env.local.*", "effect": "deny" },
    { "action": "read", "resource": ".env", "effect": "ask" },
    { "action": "read", "resource": "*/.env", "effect": "ask" },
    { "action": "read", "resource": ".env.*", "effect": "ask" },
    { "action": "read", "resource": "*/.env.*", "effect": "ask" },
    { "action": "read", "resource": ".env.schema", "effect": "allow" },
    { "action": "read", "resource": "*/.env.schema", "effect": "allow" },
    { "action": "read", "resource": ".envrc.private", "effect": "deny" },
    { "action": "read", "resource": "*/.envrc.private", "effect": "deny" },
    { "action": "read", "resource": ".secrets", "effect": "deny" },
    { "action": "read", "resource": "*/.secrets", "effect": "deny" },
    { "action": "read", "resource": ".secrets.*", "effect": "deny" },
    { "action": "read", "resource": "*/.secrets.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "*/service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "terraform.tfstate", "effect": "deny" },
    { "action": "read", "resource": "*/terraform.tfstate", "effect": "deny" },
    { "action": "read", "resource": "terraform.tfstate.*", "effect": "deny" },
    { "action": "read", "resource": "*/terraform.tfstate.*", "effect": "deny" },
    { "action": "read", "resource": ".terraform/**", "effect": "deny" },
    { "action": "read", "resource": "*/.terraform/**", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/config", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "description": "Implements and verifies changes, delegating bounded work aggressively.",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "reuse-scout": "allow",
          "librarian": "allow",
          "implementer": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "documenter": "allow"
        }
      },
      "system": "{file:./prompts/build.md}"
    },
    "plan": {
      "description": "Investigates requests and produces implementation-ready plans without making changes.",
      "mode": "primary",
      "permission": {
        "bash": {
          "*": "deny",
          "deno task check": "allow",
          "deno task lint": "allow",
          "deno task lint:check": "allow",
          "deno task format:check": "allow",
          "npm task check": "allow",
          "npm task lint": "allow",
          "npm task lint:check": "allow",
          "npm task format:check": "allow",
          "nub task check": "allow",
          "nub task lint": "allow",
          "nub task format:check": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git status *": "allow"
        },
        "edit": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "reuse-scout": "allow",
          "librarian": "allow",
          "debugger": "allow",
          "reviewer": "allow",
          "documenter": "allow"
        }
      },
      "system": "{file:./prompts/plan.md}"
    },
    "explore": {
      "description": "Performs bounded local repository discovery and dependency tracing.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/explorer.md}"
    },
    "reuse-scout": {
      "description": "Finds reusable local helpers, utilities, hooks, components, and patterns for proposed implementation work.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/reuse-scout.md}"
    },
    "general": {},
    "title": {},
    "summary": {},
    "compaction": {},
    "librarian": {
      "description": "Performs bounded external and version-specific research using authoritative sources.",
      "hidden": true,
      "mode": "subagent",
      "permission": { "bash": "deny", "edit": "deny", "webfetch": "allow", "task": "deny" },
      "system": "{file:./prompts/librarian.md}"
    },
    "implementer": {
      "description": "Performs bounded implementation work within explicit caller-owned files or subsystems.",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/implementer.md}"
    },
    "debugger": {
      "description": "Investigates failures and returns evidence-based root cause analyses and resolution guidance.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "npm test": "allow",
          "npm run format:check": "allow",
          "npm run lint": "allow",
          "npm run lint:check": "allow",
          "npm run check": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/debugger.md}"
    },
    "documenter": {
      "description": "Drafts ready-to-apply technical documentation and returns it to the calling agent.",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/documenter.md}"
    },
    "reviewer": {
      "description": "Independently reviews changes for correctness, regressions, convention compliance, and readiness.",
      "mode": "subagent",
      "permission": {
        "bash": {
          "*": "deny",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "npm test": "allow",
          "npm run format:check": "allow",
          "npm run lint": "allow",
          "npm run lint:check": "allow",
          "npm run check": "allow"
        },
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      },
      "system": "{file:./prompts/reviewer.md}"
    }
  },
  "default_agent": "plan",
  "formatter": {},
  "lsp": {},
  "mcp": { "servers": {} },
  "media": { "image": { "auto_resize": true } },
  "plugins": [],
  "share": "disabled"
}
