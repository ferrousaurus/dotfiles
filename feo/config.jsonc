{
  "keymap": {
    "cancel": ["escape"],
    "confirm": ["return"],
    "delete": ["d"],
    "down": ["j", "down"],
    "move": ["m"],
    "new": ["n"],
    "scrollDown": ["]"],
    "scrollUp": "[",
    "up": ["k", "up"],
    "write": ["w"],
  },
  "theme": {
    "inactive": "orange",
    "active": "cyan",
    "success": "green",
    "info": "blue",
    "warning": "yellow",
    "error": "red",
  },
  "applications": {
    "feo": {
      "targets": {
        "config": {
          "path": "~/.config/feo/config.jsonc",
          "sources": [
            { "path": "~/.config/feo/feo/config.jsonc" },
            { "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/feo/config.jsonc" },
          ],
        },
      },
    },
    "hunk": {
      "targets": {
        "config": {
          "path": "~/.config/hunk/config.toml",
          "sources": [
            {
              "data": {
                "theme": "auto",
                "mode": "split",
                "vcs": "git",
              },
            },
            { "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/hunk/config.toml" },
          ],
        },
      },
    },
    "mise": {
      "targets": {
        "config": {
          "path": "~/.config/mise/config.toml",
          "sources": [
            { "path": "~/.config/feo/mise/config.toml" },
            { "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/mise/config.toml" },
          ],
        },
      },
    },
    "opencode": {
      "targets": {
        "config": {
          "path": "~/.config/opencode/opencode.jsonc",
          "sources": [
            {
              "data": {
                "$schema": "https://opencode.ai/config.json",
                "default_agent": "plan",
                "plugin": ["envsitter-guard@latest"],
                "lsp": true,
              },
            },
            {
              "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/opencode/opencode.jsonc",
            },
          ],
        },
      },
    },
    "zed": {
      "targets": {
        "settings": {
          "path": "~/.config/zed/settings.json",
          "sources": [
            { "path": "~/.config/feo/zed/settings.jsonc" },
            { "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/zed/settings.json" },
          ],
        },
        "theme-catppuccin-sky": {
          "path": "~/.config/zed/themes/catppuccin-sky.json",
          "sources": [
            {
              "url": "http://raw.githubusercontent.com/ferrousaurus/dotfiles/refs/heads/main/zed/themes/catppuccin-sky.json",
            },
          ],
        },
      },
    },
  },
}
